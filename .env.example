# Public HTTPS URL of the deployed app (required in production for Paymob callbacks)
APP_URL=
# Use keys and integration IDs from the same Paymob account and environment (test/live).
# Get IDs from Developers -> Payment Integrations; use card/wallet IDs for each method.
PAYMOB_API_KEY=
# Legacy API key; not used to authenticate Unified Intention API requests
# Required for POST /v1/intention/; must belong to the same test/live account as the integration IDs
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=
# Must be a configured, online wallet integration from the same test/live Paymob account
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
# HMAC secret used to authenticate Paymob transaction notifications
PAYMOB_HMAC_SECRET=
PAYMOB_ENVIRONMENT=test