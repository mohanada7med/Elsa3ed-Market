# ==========================================
# Elsa3ed Market (سوق الصعيد) - Environment Config
# ==========================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Application Base URL (injected automatically in Cloud Run)
APP_URL=http://localhost:3000

# MongoDB Database Connection
# Replace with your production MongoDB connection string
MONGODB_URI=mongodb+srv://ahmdmohanad28_db_user:<db_password>@cluster0.je3wwaw.mongodb.net/?appName=Cluster0
MONGODB_DB=Elsa3ed_market

# Authentication Secret
AUTH_SECRET=your_super_secret_jwt_or_session_key_here_min_32_chars

# Security & Rate Limiting (true | false)
ENABLE_RATE_LIMITING=true

# Cache TTL in seconds (default: 300)
CACHE_TTL_SECONDS=300

# Max Upload Size in Megabytes (default: 5)
MAX_UPLOAD_SIZE_MB=5

# Gemini AI API Key (Optional, for craft assistant features)
GEMINI_API_KEY=
