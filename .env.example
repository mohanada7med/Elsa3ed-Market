# Elsa3ed Market Environment Variables
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (Optional - falls back to in-memory store)
MONGODB_URI=
MONGODB_DB=Elsa3ed_market

# Authentication Secret
AUTH_SECRET=

# Cloudinary Storage (Optional)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini API (Server-side)
GEMINI_API_KEY=
